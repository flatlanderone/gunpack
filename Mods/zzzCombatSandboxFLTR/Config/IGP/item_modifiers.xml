<RamblingMan>

<!-- *** IGP 2.6.5.1.3 edits for 3.0 EXP -->

<conditional>
<if cond="game_version() >= version(1,3,0)">

<!-- See buffs.xml -->
<!-- Fixed mag dump with certain weapons  -->

<!-- <remove xpath="/item_modifiers/item_modifier[@name='modGunTriggerGroupAutomatic' or @name='modGunTriggerGroupBurst3']/effect_group/passive_effect[@name='BurstRoundCount']"/> -->

<!-- Reimplemented ShortBarrelmod for modShotgunSawedOffBarrel -->

<csv xpath="/item_modifiers/item_modifier[@name='modShotgunSawedOffBarrel']/@installable_tags" delim="," op="add">ShortBarrelmod</csv>


<!-- *** 7. Set CrosshairOnAim and CrosshairUpAfterShot to true for all weapon mods to fix a conflict with the 3.0 crosshair  -->

<set xpath="/item_modifiers/item_modifier/item_property_overrides/property[(@name='CrosshairOnAim' or @name='CrosshairUpAfterShot') and @value='false']/@value">true</set>


</if>
</conditional>
</RamblingMan>