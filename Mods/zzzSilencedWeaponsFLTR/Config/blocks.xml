<RamblingMan>

<conditional>
<if cond="game_version() >= version(1,3,0) and mod_loaded('Combat_Sandbox_FLTR') == false">

<!-- SMG turret -->
<set xpath="/blocks/block[@name='autoTurret']/property[@name='FireSound']/@value">smg_s_fire</set>

<!-- Shotgun turret -->
<set xpath="/blocks/block[@name='shotgunTurret']/property[@name='FireSound']/@value">pump_shotgun_s_fire</set>

<!-- M60 turret -->
<set xpath="/blocks/block[@name='m60Turret']/property[@name='FireSound']/@value">m60_s_fire</set>

</if>
</conditional>

</RamblingMan>
