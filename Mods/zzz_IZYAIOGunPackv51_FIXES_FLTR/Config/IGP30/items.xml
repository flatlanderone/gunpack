<!-- item/property
IZYAmmoHeavyWeaponFlamethrowerNapalmStandardMixture
IZYAmmoHeavyWeaponFlamethrowerNapalmLethalMixture -->

<remove xpath="/items/item[@name='IZYAmmoHeavyWeaponFlamethrowerNapalmStandardMixture' or 
@name='IZYAmmoHeavyWeaponFlamethrowerNapalmLethalMixture']/property[starts-with(@name, 'Explosion.')]" />

