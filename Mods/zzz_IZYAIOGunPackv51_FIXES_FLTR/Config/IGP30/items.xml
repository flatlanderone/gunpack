<remove xpath="/items/item[@name='ammo762mmExplosiveFragmentations' or 
@name='ammoCrossbowLightBoltStone' or 
@name='ammoCrossbowLightBoltIron' or 
@name='ammoRocketRPGTraning' or 
@name='ammoRocketRPGHE' or 
@name='ammoRocketRPGIncendiary' or 
@name='ammo25mmGrenadeTraining' or 
@name='ammo25mmGrenadeFRAGS' or 
@name='ammo25mmGrenadeHE' or 
@name='IZYAmmoHeavyWeaponFlamethrowerNapalmStandardMixture' or 
@name='IZYAmmoHeavyWeaponFlamethrowerNapalmLethalMixture']/property[@class='Action1']/property[starts-with(@name, 'Explosion.')]" />


<!-- ToolCategory.harvestingTools -->

<remove xpath="/items/item[@name='IZYMeleeT4BatonPunisher9000' or 
@name='IZYMeleeT4BladeKatana' or 
@name='IZYMeleeT4DualKnivesKnife' or 
@name='IZYMeleeT4SpearPoleAxe' or 
@name='IZYMeleeT4SledghammerSpikeMace']/property/property[starts-with(@name, 'ToolCategory.')]" />

